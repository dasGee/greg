[sub_resource type="GDScript" id="GDScript_sao81"]
script/source = "extends TileMapLayer
func _process(_delta: float) -> void:
	if Input.is_action_pressed(\"down\"):
		collision_enabled = false
	else:
		collision_enabled = true
"

